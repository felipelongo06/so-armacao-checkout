{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": { "maxDuration": 15 },
    "api/pedido/*.js": { "maxDuration": 15 },
    "api/cron/*.js": { "maxDuration": 15 },
    "api/bling/*.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/reconciliar", "schedule": "0 9 * * *" },
    { "path": "/api/bling/sync", "schedule": "17 5 * * *" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
